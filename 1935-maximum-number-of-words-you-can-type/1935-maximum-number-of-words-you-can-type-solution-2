class Solution {
    public int canBeTypedWords(String text, String brokenLetters) {
        int len = brokenLetters.length();
        if(len == 26) return 0;
        boolean[] check = new boolean[26];
        for(char ch : brokenLetters.toCharArray()){
            check[ch - 'a'] = true;
        }

        boolean curr = true;
        int n= 0;
        for(char ch : text.toCharArray()){
            if(ch != ' ' && check[ch - 'a']) {
                curr = false;
            }
            if(ch == ' '){
                if(curr){
                    n++;
                }
                curr = true;
            }
        }
        if(curr) n++;
        return n;
    }
}